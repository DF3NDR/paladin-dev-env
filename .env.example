# .env.example - Copy to .env and customize for your environment

# Application Configuration
APP_ENV=development
RUST_LOG=info
RUST_BACKTRACE=0

# Server Configuration
APP_SERVER_HOST=0.0.0.0
APP_SERVER_PORT=8080

# LLM Configuration
#
# Legacy top-level fields (unused by the agent host but required by the schema).
LLM_TYPE=openai
LLM_URL=https://api.openai.com/v1
LLM_API_KEY=your_openai_api_key_here

# ---------------------------------------------------------------------------
# Per-provider LLM environment variables (used by provider adapters and live
# integration tests). This is the code-derived environment-variable surface —
# every name below is read by an adapter in crates/paladin-llm/src via
# `env::var`; a name here that no adapter reads, or a read an adapter makes
# that is absent here, is drift (see 17-20-PLAN.md).
#
# Keep every *_API_KEY value EMPTY in source control. Set real values in your
# local .env only (.env is gitignored; .env.example is committed).
#
# CREDENTIAL PROVENANCE (devcontainer): these keys arrive from
# ~/.config/paladin/ (one file per secret, filename = the lowercased variable
# name, e.g. ~/.config/paladin/xai_api_key -> XAI_API_KEY) via
# .devcontainer/paladin-env.sh, sourced automatically into interactive shells
# by ~/.bashrc. A genuinely-exported non-empty value always wins over the
# file. A NON-INTERACTIVE shell (a script, a CI step, an agent's Bash tool)
# does not run ~/.bashrc and therefore does NOT source paladin-env.sh
# automatically -- it must be sourced explicitly:
#   set -a; . .devcontainer/paladin-env.sh; set +a
# ---------------------------------------------------------------------------

# OpenAI
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORGANIZATION=
# OPENAI_TIMEOUT_SECONDS=300
# OPENAI_MAX_RETRIES=3

# Anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_MAX_TOKENS=4096
# ANTHROPIC_TIMEOUT_SECONDS=60

# DeepSeek
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TIMEOUT_SECONDS=60

# Kimi (Moonshot AI) -- live-verified 2026-08-22 (plan 17-19)
MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# MOONSHOT_MODEL=kimi-k3
# MOONSHOT_TIMEOUT_SECONDS=60

# Qwen (Alibaba DashScope) -- live-verified 2026-08-23 (plan 17-21 gap
# closure): model list (162 models) and generate() both succeeded at the
# shipped endpoint below.
#
# DashScope API keys are scoped to the Model Studio region that issued them
# and are REJECTED by every other region's endpoint. The default below is
# Singapore. If your workspace is in the US or on the mainland, you MUST
# set DASHSCOPE_BASE_URL to your own region's endpoint:
#   Singapore        (shipped default): https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   US (Virginia):                      https://dashscope-us.aliyuncs.com/compatible-mode/v1
#   China (mainland):                   https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen-plus
# DASHSCOPE_TIMEOUT_SECONDS=60

# Grok (xAI) -- live-verified 2026-08-22 (plan 17-18)
XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4.6
# XAI_TIMEOUT_SECONDS=60

# Gemini (Google) -- live-verified; bespoke generateContent protocol, not
# OpenAI-compatible
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_TIMEOUT_SECONDS=60

# Ollama (self-hosted) -- no credential required (D-12); no vendor endpoint
# to verify, live-exercised via the Docker Tier 2 suite (UAT test 3)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3
# OLLAMA_TIMEOUT_SECONDS=60

# Generic operator-configured OpenAI-compatible provider -- points Paladin at
# ANY OpenAI-compatible endpoint not named above (self-hosted vLLM/LiteLLM,
# Groq, Together, Mistral, Fireworks, Bedrock's OpenAI-compat mode, ...).
# NOT the same credential as OPENAI_API_KEY above -- these two names are one
# word apart and are two different credentials for two different providers;
# read both character-by-character before exporting either.
# base_url and model are REQUIRED here -- there is no vendor default (D-03).
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
# OPENAI_COMPATIBLE_TIMEOUT_SECONDS=60
#
# Capability flags. Unset means the conservative answer for every one of
# these -- this adapter must never claim a capability nobody asserted (D-04).
# OPENAI_COMPATIBLE_SUPPORTS_STREAMING=true
# OPENAI_COMPATIBLE_SUPPORTS_TOOL_CALLING=false
# OPENAI_COMPATIBLE_SUPPORTS_FUNCTION_CALLING=false
# OPENAI_COMPATIBLE_SUPPORTS_VISION=false
# OPENAI_COMPATIBLE_SUPPORTS_EMBEDDINGS=false
# OPENAI_COMPATIBLE_SUPPORTS_SYSTEM_MESSAGES=false
# OPENAI_COMPATIBLE_MAX_CONTEXT_TOKENS=
#
# Both or neither -- unset falls back to ADR-0004's global [0.0, 1.0]. Only
# this provider reads temperature from the environment; no other provider has
# a per-vendor temperature variable because no other adapter reads one.
# OPENAI_COMPATIBLE_TEMPERATURE_MIN=
# OPENAI_COMPATIBLE_TEMPERATURE_MAX=

# Redis Queue Configuration
APP_REDIS_HOST=localhost
APP_REDIS_PORT=6379
APP_REDIS_PASSWORD=
APP_REDIS_DB=0
APP_REDIS_CONNECTION_TIMEOUT=30
APP_REDIS_KEY_PREFIX=paladin:queue
APP_REDIS_MAX_RETRIES=3
APP_REDIS_ENABLE_PRIORITY_QUEUES=true

# Redis Service Configuration (Docker)
REDIS_PASSWORD=
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=admin

# S3-compatible object store (RustFS) - application side. The APP_MINIO_* names are
# unchanged (Phase 45 D-04); the values must match RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY below.
APP_MINIO_ENDPOINT=localhost:9000
APP_MINIO_ACCESS_KEY=paladin-dev
APP_MINIO_SECRET_KEY=paladin-dev-secret
APP_MINIO_BUCKET=paladin-files
APP_MINIO_REGION=us-east-1
APP_MINIO_SECURE=false
APP_MINIO_PATH_STYLE=true
APP_MINIO_CONNECTION_TIMEOUT=30
APP_MINIO_REQUEST_TIMEOUT=300
APP_MINIO_MAX_IDLE_CONNS=10
APP_MINIO_MAX_FILE_SIZE=104857600
APP_MINIO_ALLOWED_EXTENSIONS=txt,md,json,pdf,doc,docx,jpg,png,gif,rs,py,js,html,css,xml

# RustFS Service Configuration (Docker) - store-side root credentials read by
# docker/docker-compose.yml. Throwaway dev values: never use the image's default
# credential, and never reuse these outside a local stack.
# A local .env from before Phase 45 must rename its two store-side variables
# (MINIO_ROOT_USER -> RUSTFS_ACCESS_KEY, MINIO_ROOT_PASSWORD -> RUSTFS_SECRET_KEY).
RUSTFS_ACCESS_KEY=paladin-dev
RUSTFS_SECRET_KEY=paladin-dev-secret

# Message Service Configuration
MESSAGE_SERVICE_MAX_QUEUE_SIZE=10000
MESSAGE_SERVICE_WORKER_THREADS=4
MESSAGE_SERVICE_ENABLE_PERSISTENCE=false
MESSAGE_SERVICE_DEFAULT_TTL_SECONDS=3600
MESSAGE_SERVICE_RETRY_ATTEMPTS=3
MESSAGE_SERVICE_RETRY_DELAY_MS=1000

# Database Configuration
DATABASE_URL=sqlite:database.db
APP_MAX_FILE_SIZE=10485760

# Test Configuration
USE_EXTERNAL_TEST_SERVICES=false
TEST_REDIS_HOST=localhost
TEST_REDIS_PORT=6380
TEST_MINIO_ENDPOINT=localhost:9010
TEST_MINIO_ACCESS_KEY=testuser
TEST_MINIO_SECRET_KEY=testpass123
TEST_LOG=0

# Optional: enable live API test target in your local workflow
# Tests are still marked #[ignore] and must be run with --ignored.
LIVE_API_TESTS_ENABLED=true

# Development Tools
ENABLE_DEBUG_TOOLS=true
ENABLE_PROFILING=false

# Security Configuration
ENABLE_CORS=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
ENABLE_RATE_LIMITING=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL=30

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout
ENABLE_REQUEST_LOGGING=true

# Performance Configuration
WORKER_THREADS=4
MAX_CONNECTIONS=1000
CONNECTION_TIMEOUT=30
REQUEST_TIMEOUT=60

# Feature Flags
ENABLE_EXPERIMENTAL_FEATURES=false
ENABLE_ANALYTICS=false
ENABLE_CACHING=true
CACHE_TTL=3600
