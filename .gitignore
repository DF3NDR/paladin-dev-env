config.yml
flattenrs*
/flat
# Snyk Security Extension - AI Rules (auto-generated)
.VSCodeCounter/
lcov.info

# CycloneDX SBOM output (generated by `make sbom` / cargo-cyclonedx)
*.cdx.json
bom.json

# Claude Code - personal/local settings (shared config in .claude/settings.json IS committed)
