# Multi-stage Dockerfile for the Paladin HTTP API server (`paladin-server`).
#
# Builds the `web-server` feature (the agent HTTP API: /v1 routes, health/readiness,
# OpenAPI docs, auth) and runs it from a minimal Debian runtime. Health checking is left
# to the orchestrator's probes (see k8s/server/) — `debian:12-slim` has no curl.
#
#   docker build -f Dockerfile.server -t paladin-server:0.6.0 .
#   docker run --rm -p 8080:8080 \
#     -e PALADIN_API_KEY_CI=sk-... -e OPENAI_API_KEY=sk-... paladin-server:0.6.0

# =============================================================================
# Stage 1: Builder — compiles `paladin-server` with the `web-server` feature.
# Bookworm (Debian 12) for OpenSSL 3.x, matching the runtime ABI.
# =============================================================================
FROM rust:1.93-slim-bookworm AS builder
WORKDIR /app

# `curl` is required by the `utoipa-swagger-ui` build script to download the Swagger UI
# bundle during the build (the `web-server` feature depends on it).
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy the workspace sources needed to resolve and build the bin.
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY crates ./crates
COPY benches ./benches
# SQL migrations are embedded in the binary at compile time (D-17,
# crates/paladin-memory/src/migrations.rs) -- no migrations/ directory to copy.

# Build only the server binary with its feature.
RUN cargo build --release --bin paladin-server --features web-server

# Strip debug symbols to shrink the image.
RUN strip target/release/paladin-server

# =============================================================================
# Stage 2: Runtime — minimal image with the binary and a default config.
# =============================================================================
FROM debian:12-slim
WORKDIR /app

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Binary + a baked default config (secrets are supplied at runtime via env vars).
COPY --from=builder /app/target/release/paladin-server /usr/local/bin/paladin-server
COPY config.example.yml /etc/paladin/config.yml

# Non-root user.
RUN groupadd -g 65532 paladin && \
    useradd -u 65532 -g paladin -s /bin/false -M paladin
USER paladin:paladin

EXPOSE 8080
ENV PALADIN_CONFIG=/etc/paladin/config.yml

# Health is checked by the orchestrator (k8s liveness/readiness → /health, /ready).
HEALTHCHECK NONE

ENTRYPOINT ["/usr/local/bin/paladin-server"]
