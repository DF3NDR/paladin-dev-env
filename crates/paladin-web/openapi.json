          },
          "501": {
            "description": "No waypoint backend configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "api_key": []
          },
          {
            "bearer_token": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AgentSpec": {
        "type": "object",
        "description": "Declarative description of an agent to provision at runtime.\n\nSent in the body of `POST /agents`. Because `paladin-web` cannot itself build a\n[`Paladin`] (that needs an `LlmPort` and the builder, which live behind the\nfacade), an [`AgentProvisioner`] turns this spec into a concrete\n`(Paladin, executor)` pair.\n\nOnly the fields needed to identify and shape an agent are included here; the\nprovisioner is free to apply defaults for everything else. More fields can be\nadded without breaking existing callers (all optional fields use `#[serde(default)]`).",
        "required": [
          "id",
          "name",
          "model",
          "system_prompt"
        ],
        "properties": {
          "allowed_roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Roles permitted to invoke this agent (`\"admin\"`/`\"user\"`); empty ⇒ any caller."
          },
          "id": {
            "type": "string",
            "description": "Registry id (the path segment in `/agents/{id}/…`). Client-supplied and unique."
          },
          "model": {
            "type": "string",
            "description": "LLM model identifier (e.g. `\"gpt-4\"`)."
          },
          "name": {
            "type": "string",
            "description": "Human-friendly display name."
          },
          "stop_words": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional stop words that terminate execution."
          },
          "system_prompt": {
            "type": "string",
            "description": "System prompt defining the agent's behavior."
          },
          "temperature": {
            "type": [
              "number",
              "null"
            ],
            "format": "float",
            "description": "Optional response randomness (`0.0`–`1.0`); the provisioner applies a default when absent."
          },
          "timeout_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Optional per-agent execution timeout (seconds); `None` uses the server default.",
            "minimum": 0
          }
        }
      },
      "AgentSummary": {
        "type": "object",
        "description": "Safe, public-facing summary of an agent for the discovery endpoints.\n\nDeliberately omits anything sensitive. Note that secrets (API keys, provider\ncredentials) never live on the [`Paladin`] entity in the first place — they are\nsupplied to executors at composition time — so none can leak here. The raw system\nprompt is reduced to a short `description` preview rather than returned verbatim\n(see PRD Open Question 1 on whether to omit it entirely).",
        "required": [
          "id",
          "name",
          "model",
          "description"
        ],
        "properties": {
          "description": {
            "type": "string",
            "description": "Short, single-line preview derived from the system prompt."
          },
          "id": {
            "type": "string",
            "description": "Registry id (the `{id}` path segment)."
          },
          "model": {
            "type": "string",
            "description": "LLM model identifier."
          },
          "name": {
            "type": "string",
            "description": "Human-friendly display name."
          }
        }
      },
      "ApiErrorBody": {
        "type": "object",
        "description": "OpenAPI schema for the error envelope returned by every failing handler.\n\nMirrors [`ApiError::to_body`] (`{ \"error\": { \"code\", \"message\", \"details\" } }`); it exists\npurely so the generated spec can describe error responses. The runtime body is built by\n`ApiError`, not this type.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorDetail",
            "description": "The error detail object."
          }
        }
      },
      "ApiErrorDetail": {
        "type": "object",
        "description": "The `error` object inside [`ApiErrorBody`].",
        "required": [
          "code",
          "message",
          "details"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable, machine-readable error code (e.g. `\"not_found\"`, `\"unauthorized\"`)."
          },
          "details": {
            "type": [
              "object",
              "null"
            ],
            "description": "Optional structured context; `null` when absent."
          },
          "message": {
            "type": "string",
            "description": "Human-readable message."
          }
        }
      },
      "ExecuteRequest": {
        "type": "object",
        "description": "Request body for `POST /agents/{id}/execute`.\n\nOnly `input` is required today; later epics may add optional fields (streaming\nflags, per-call overrides) without breaking this contract.",
        "required": [
          "input"
        ],
        "properties": {
          "input": {
            "type": "string",
            "description": "The task / prompt to run the agent against."
          },
          "timeout_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Optional per-request timeout (seconds), clamped to the server max. `0` is rejected.",
            "minimum": 0
          }
        }
      },
      "ExecuteResponse": {
        "type": "object",
        "description": "Response body for a successful agent execution.\n\nCarries the agent output plus the safe execution metadata from\n[`PaladinResult`]. The `stop_reason` is rendered as a stable lowercase label\n(`\"completed\"`, `\"max_loops\"`, `\"stop_word\"`, `\"timeout\"`) rather than the raw\nserde enum shape, so the wire contract is stable.",
        "required": [
          "output",
          "token_count",
          "execution_time_ms",
          "loop_count",
          "stop_reason"
        ],
        "properties": {
          "execution_time_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Wall-clock execution time in milliseconds.",
            "minimum": 0
          },
          "loop_count": {
            "type": "integer",
            "format": "int32",
            "description": "Number of reasoning loops executed.",
            "minimum": 0
          },
          "output": {
            "type": "string",
            "description": "The generated output text."
          },
          "stop_reason": {
            "type": "string",
            "description": "Why execution stopped, as a stable label."
          },
          "token_count": {
            "type": "integer",
            "format": "int32",
            "description": "Total tokens used (prompt + completion).",
            "minimum": 0
          }
        }
      },
      "HistoryResponse": {
        "type": "object",
        "description": "Response body for `GET /threads/{id}/history`.\n\n`next_cursor` is `None` on the last page; otherwise it is the last\nreturned item's `waypoint_id`, opaque to clients (D-27) -- its internal\nstructure may change (PLAT-06) without this being a breaking change.",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WaypointSummaryDto"
            },
            "description": "The page of waypoint summaries, newest-first."
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Opaque cursor for the next page, or `None` on the last page."
          }
        }
      },
      "JobRecord": {
        "type": "object",
        "description": "A stored job: its status plus, when finished, a result or error.\n\n`result` is the serialized success payload (an `ExecuteResponse` as JSON), kept as a\n[`Value`] so the store stays decoupled from the controller's wire types.",
        "required": [
          "status"
        ],
        "properties": {
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "Error message, present once `status == Failed`/`TimedOut`."
          },
          "result": {
            "type": [
              "object",
              "null"
            ],
            "description": "Success payload (an `ExecuteResponse` as JSON), present once `status == Completed`."
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus",
            "description": "Current status."
          }
        }
      },
      "JobStatus": {
        "type": "string",
        "description": "Lifecycle status of an async job.",
        "enum": [
          "running",
          "completed",
          "failed",
          "timed_out"
        ]
      },
      "ParleyRequestDto": {
        "type": "object",
        "description": "Wire projection of a [`ParleyRequest`] (a `paladin-core` type) into a\n`utoipa::ToSchema` type this crate owns (ADR-0038).",
        "required": [
          "parley_id",
          "node_id",
          "kind",
          "prompt",
          "payload",
          "created_at"
        ],
        "properties": {
          "choices": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Valid choices, populated for `\"choice\"`; `None` otherwise."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When this parley was raised."
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When this parley expires, if ever."
          },
          "kind": {
            "type": "string",
            "description": "The shape of input awaited (`\"approval\"`, `\"choice\"`, `\"free_text\"`, `\"state_edit\"`)."
          },
          "node_id": {
            "type": "string",
            "description": "The node that raised this parley."
          },
          "parley_id": {
            "type": "string",
            "description": "The outstanding parley's identity."
          },
          "payload": {
            "type": "object",
            "description": "Author-supplied context rendered alongside `prompt`."
          },
          "prompt": {
            "type": "string",
            "description": "Free-form prompt describing what input is being awaited."
          }
        }
      },
      "ParleyResponseDto": {
        "type": "object",
        "description": "Wire projection of a [`ParleyResponse`].",
        "required": [
          "parley_id",
          "kind",
          "prompt",
          "value",
          "responded_at",
          "defaulted"
        ],
        "properties": {
          "defaulted": {
            "type": "boolean",
            "description": "Whether this response was substituted by an `on_expire` default\nrather than submitted by a caller."
          },
          "kind": {
            "type": "string",
            "description": "The originating parley's `kind`."
          },
          "parley_id": {
            "type": "string",
            "description": "The parley this response answers."
          },
          "prompt": {
            "type": "string",
            "description": "The originating parley's `prompt`."
          },
          "responded_at": {
            "type": "string",
            "format": "date-time",
            "description": "When this response was recorded."
          },
          "responded_by": {
            "type": [
              "string",
              "null"
            ],
            "description": "Who submitted this response, if known."
          },
          "value": {
            "type": "object",
            "description": "The submitted value."
          }
        }
      },
      "ParleyResponseInput": {
        "type": "object",
        "description": "One submitted answer inside a [`ResumeRequest`].\n\n`kind`/`prompt` are intentionally absent: `WarEngine::resume_with`\nstamps both onto the persisted response from the matching request's own\nfields, regardless of what a caller supplies (D-07) -- so this DTO never\nasks a client to know or repeat them.",
        "required": [
          "parley_id",
          "value"
        ],
        "properties": {
          "parley_id": {
            "type": "string",
            "description": "The parley this response answers."
          },
          "responded_by": {
            "type": [
              "string",
              "null"
            ],
            "description": "Who is submitting this response, if the caller wants it recorded."
          },
          "value": {
            "type": "object",
            "description": "The submitted value, validated per the parley's own `kind`."
          }
        }
      },
      "ResumeAcceptedResponse": {
        "type": "object",
        "description": "Response body for a successful `POST /threads/{id}/resume` (`202 Accepted`).",
        "required": [
          "thread_id",
          "state_url"
        ],
        "properties": {
          "state_url": {
            "type": "string",
            "description": "The URL a client polls (`GET .../state`) to observe the outcome."
          },
          "thread_id": {
            "type": "string",
            "description": "The thread whose resume was accepted."
          }
        }
      },
      "ResumeRequest": {
        "type": "object",
        "description": "Request body for `POST /threads/{id}/resume`.",
        "properties": {
          "responses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParleyResponseInput"
            },
            "description": "Every response to submit in this call."
          }
        }
      },
      "ThreadStateResponse": {
        "type": "object",
        "description": "Response body for `GET /threads/{id}/state`.\n\n`parleys`/`responses` are always present, empty unless `status` is\n`\"awaiting_input\"` (Test 2: a running/completed thread carries the\nsummary fields with no outstanding parleys, not an omitted key).",
        "required": [
          "thread_id",
          "status",
          "superstep",
          "waypoint_id",
          "parleys",
          "responses"
        ],
        "properties": {
          "fork_of": {
            "type": [
              "string",
              "null"
            ],
            "description": "The ROOT `WaypointId` of the branch this Waypoint belongs to;\n`None` for a mainline Waypoint (HITL-03, D-14)."
          },
          "parleys": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParleyRequestDto"
            },
            "description": "Every parley raised in the suspending superstep, when `status` is\n`\"awaiting_input\"`; empty otherwise."
          },
          "responses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParleyResponseDto"
            },
            "description": "The accepted subset of responses so far, when `status` is\n`\"awaiting_input\"`; empty otherwise."
          },
          "status": {
            "type": "string",
            "description": "Stable, lowercase status label."
          },
          "superstep": {
            "type": "integer",
            "format": "int64",
            "description": "The superstep index of the returned Waypoint.",
            "minimum": 0
          },
          "thread_id": {
            "type": "string",
            "description": "The thread's identity."
          },
          "waypoint_id": {
            "type": "string",
            "description": "The returned Waypoint's own identity."
          }
        }
      },
      "WaypointSummaryDto": {
        "type": "object",
        "description": "Wire projection of a [`WaypointSummary`].",
        "required": [
          "waypoint_id",
          "superstep",
          "status",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When this waypoint was created."
          },
          "fork_of": {
            "type": [
              "string",
              "null"
            ],
            "description": "The ROOT `WaypointId` of the branch this waypoint belongs to;\n`None` for a mainline waypoint."
          },
          "parent_waypoint_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The waypoint this one was checkpointed from."
          },
          "status": {
            "type": "string",
            "description": "Stable, lowercase status label."
          },
          "superstep": {
            "type": "integer",
            "format": "int64",
            "description": "The superstep index that produced this waypoint.",
            "minimum": 0
          },
          "waypoint_id": {
            "type": "string",
            "description": "The summarized waypoint's identity."
          }
        }
      }
    },
    "securitySchemes": {
      "api_key": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "bearer_token": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
