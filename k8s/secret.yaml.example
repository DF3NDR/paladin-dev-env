# EXAMPLE: Kubernetes Secret for Paladin API Keys
#
# DO NOT COMMIT THIS FILE WITH REAL SECRETS!
# This is a template. Copy to secret.yaml and fill in your values.
#
# Usage:
# 1. Copy this file: cp secret.yaml.example secret.yaml
# 2. Replace base64-encoded values with your actual API keys
# 3. Apply: kubectl apply -f k8s/secret.yaml
# 4. Add secret.yaml to .gitignore
#
# To base64 encode a value:
#   echo -n "your-api-key-here" | base64

apiVersion: v1
kind: Secret
metadata:
  name: paladin-secrets
  namespace: paladin
  labels:
    app: paladin
type: Opaque
data:
  # LLM Provider API Keys (base64 encoded)
  # Example: echo -n "sk-proj-..." | base64
  OPENAI_API_KEY: "c2stcHJvai1ZT1VSLUtFWS1IRVJF"  # Replace with: echo -n "sk-..." | base64
  DEEPSEEK_API_KEY: "ZGVlcHNlZWstWU9VUi1LRVktSEVSRQ=="  # Replace with: echo -n "..." | base64
  ANTHROPIC_API_KEY: "c2stYW50LVlPVVItS0VZLUhFUkU="  # Replace with: echo -n "..." | base64

  # Redis password (if authentication enabled)
  REDIS_PASSWORD: ""  # Optional: echo -n "password" | base64

  # Object store (RustFS) root credentials, read by k8s/rustfs.yaml.
  # PLACEHOLDERS: replace both with your own values (echo -n "..." | base64).
  RUSTFS_ACCESS_KEY: "cGFsYWRpbi1zdG9yZQ=="  # placeholder "paladin-store" (base64)
  RUSTFS_SECRET_KEY: "Y2hhbmdlLW1lLXN0b3JlLXNlY3JldA=="  # placeholder "change-me-store-secret" (base64)

  # Application-side object-store credentials (the app's MINIO_* names are unchanged).
  # They must match the RustFS root credentials above unless you provision a separate
  # RustFS IAM user; the reference manifest provisions none.
  MINIO_ACCESS_KEY: "cGFsYWRpbi1zdG9yZQ=="  # must match RUSTFS_ACCESS_KEY
  MINIO_SECRET_KEY: "Y2hhbmdlLW1lLXN0b3JlLXNlY3JldA=="  # must match RUSTFS_SECRET_KEY

---
# Alternative: Using External Secrets Operator (Recommended for Production)
#
# If you're using External Secrets Operator with AWS Secrets Manager, Azure Key Vault,
# or HashiCorp Vault, use this pattern instead:

# apiVersion: external-secrets.io/v1beta1
# kind: ExternalSecret
# metadata:
#   name: paladin-secrets
#   namespace: paladin
# spec:
#   refreshInterval: 1h
#   secretStoreRef:
#     name: aws-secretsmanager
#     kind: SecretStore
#   target:
#     name: paladin-secrets
#     creationPolicy: Owner
#   data:
#     - secretKey: OPENAI_API_KEY
#       remoteRef:
#         key: paladin/openai-api-key
#     - secretKey: DEEPSEEK_API_KEY
#       remoteRef:
#         key: paladin/deepseek-api-key
#     - secretKey: ANTHROPIC_API_KEY
#       remoteRef:
#         key: paladin/anthropic-api-key
