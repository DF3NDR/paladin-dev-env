# Secret for paladin-server. It carries the WHOLE server config (`config.yml`) and the provider key.
#
# Copy this file to `k8s/server/secret.yaml` (gitignored), fill it in, and NEVER commit it:
#   cp k8s/server/secret.yaml.example k8s/server/secret.yaml
#   # paste literal API keys into config.yml's http.auth.api_keys (for example from
#   # `openssl rand -hex 32`) and the provider key into openai-api-key, then:
#   kubectl apply -f k8s/server/secret.yaml
#
# Why the whole config.yml lives in a Secret: it holds literal API keys, and the server reads
# exactly one file (PALADIN_CONFIG) and expands nothing in `http.auth.api_keys`. A ConfigMap is
# readable by a wider set of principals and is not secret material, so it cannot hold them. Only
# `llm.<provider>.api_key` resolves an exact "${NAME}", here from OPENAI_API_KEY, which both
# Deployments inject from the `openai-api-key` key below.
#
# An unfilled template fails closed: every `key` below is empty, and the server refuses to boot
# with `http.auth.api_keys[#0]: 'key' must not be empty` instead of loading a placeholder.
#
# Or create it imperatively from a filled-in config.yml:
#   kubectl -n paladin create secret generic paladin-server-secrets \
#     --from-literal=openai-api-key=sk-... \
#     --from-file=config.yml=./config.yml
apiVersion: v1
kind: Secret
metadata:
  name: paladin-server-secrets
  namespace: paladin
  labels:
    app: paladin-server
type: Opaque
stringData:
  openai-api-key: "REPLACE_ME" # provider key for agent execution
  config.yml: |
    # Legacy top-level LLM fields: required by the schema, unused by the agent host.
    llm_type: "openai"
    llm_url: "https://api.openai.com/v1"
    llm_api_key: "" # legacy field, required by the schema, read by nothing
    max_file_size: 10485760
    sources: []

    # Structured provider config. An exact "${NAME}" in `api_key` is read from the variable NAME
    # (an unset variable is an error naming it, never sent as the key). Both Deployments inject
    # OPENAI_API_KEY from the `openai-api-key` key of this Secret.
    llm:
      default_provider: "openai"
      openai:
        api_key: "${OPENAI_API_KEY}"

    server:
      host: "0.0.0.0"
      port: 8080

    timeouts:
      default_seconds: 300
      max_seconds: 600

    http:
      # Enabled by default and fail-closed: the keys below are literal values pasted into this
      # Secret. Nothing here is expanded, and a key containing `${` is refused at boot.
      auth:
        enabled: true
        # `tenant` is REQUIRED on every key (Phase 40, TENANT-01) -- runs and spend are
        # attributed to it, and a key reads only its own tenant's runs unless its role is
        # admin. No implicit default tenant; an empty/missing value fails boot.
        api_keys:
          - key: "" # paste a literal secret here (for example `openssl rand -hex 32`)
            name: "ci-runner"
            role: "admin"
            tenant: "platform-ops"
          - key: "" # paste a different literal secret here
            name: "frontend"
            role: "user"
            tenant: "web-app"
        # The shipped AuthPort implementation behind this flag is an in-process, per-pod
        # token store: a token issued by one pod does not verify on another. Flipping this
        # to true requires pinning the Deployment to a single replica until the shared-store
        # implementation exists (ADR-0041). Leave false to keep horizontal scaling safe —
        # the API keys above are byte-identical in every pod.
        bearer_token:
          enabled: false
          # Required when `enabled` is true (Phase 40, TENANT-01, D-03):
          # tenant: "bearer-callers"
      # Serve the OpenAPI spec + Swagger UI (set false to disable in production).
      docs:
        enabled: true

    agents:
      - id: "researcher"
        provider: "openai"
        model: "gpt-4"
        system_prompt: "You research topics thoroughly."
        allowed_roles: ["admin", "user"]
